@article{suEpitaxialGrowthStructural2021,
  title = {Epitaxial {{Growth}} and {{Structural Characterizations}} of {{MnBi2Te4 Thin Films}} in {{Nanoscale}}},
  author = {Su, Shu-Hsuan and Chang, Jen-Te and Chuang, Pei-Yu and Tsai, Ming-Chieh and Peng, Yu-Wei and Lee, Min Kai and Cheng, Cheng-Maw and Huang, Jung-Chung Andrew},
