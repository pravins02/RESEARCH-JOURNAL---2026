  title = {Tailoring Optical Excitation to Control Magnetic Skyrmion Nucleation},
  author = {Kern, L.-M. and Pfau, B. and Schneider, M. and Gerlinger, K. and Deinhart, V. and Wittrock, S. and Sidiropoulos, T. and Engel, D. and Will, I. and G{\"u}nther, C. M. and Litzius, K. and Wintz, S. and Weigand, M. and B{\"u}ttner, F. and Eisebitt, S.},
