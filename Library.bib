@article{heUltrafastLaserPulse2023,
  title = {Ultrafast {{Laser Pulse Induced Transient Ferrimagnetic State}} and {{Spin Relaxation Dynamics}} in {{Two-Dimensional Antiferromagnets}}},
  author = {He, Junjie and Li, Shuo and Frauenheim, Thomas and Zhou, Zhaobo},
