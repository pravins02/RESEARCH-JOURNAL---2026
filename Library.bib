  title = {Spin Transfer Torque Switching Dynamics in {{CoFeB}}/{{MgO}} Magnetic Tunnel Junctions},
  author = {Meo, A. and {Sampan-a-pai}, S. and Visscher, P. B. and Chepulskyy, R. and Apalkov, D. and Chureemart, J. and Chureemart, P. and Chantrell, R. W. and Evans, R. F. L.},
  year = {2021},
