@article{zhuElectronicCorrelationMagnetism2016,
  title = {Electronic Correlation and Magnetism in the Ferromagnetic Metal \$\{{\textbackslash}mathrm\{\vphantom{\}\}}{{Fe}}\vphantom\{\}\vphantom\{\}\_\{3\}\{{\textbackslash}mathrm\{\vphantom{\}\}}{{GeTe}}\vphantom\{\}\vphantom\{\}\_\{2\}\$},
  author = {Zhu, Jian-Xin and Janoschek, Marc and Chaves, D. S. and Cezar, J. C. and Durakiewicz, Tomasz and Ronning, Filip and Sassa, Yasmine and Mansson, Martin and Scott, B. L. and Wakeham, N. and Bauer, Eric D. and Thompson, J. D.},
  year = {2016},
