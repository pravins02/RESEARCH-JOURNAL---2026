}

@article{kimlingUltrafastDemagnetizationFePt2014,
  title = {Ultrafast Demagnetization of {{FePt}}:{{Cu}} Thin Films and the Role of Magnetic Heat Capacity},
  shorttitle = {Ultrafast Demagnetization of {{FePt}}},
  author = {Kimling, Johannes and Kimling, Judith and Wilson, R. B. and Hebler, Birgit and Albrecht, Manfred and Cahill, David G.},
  year = {2014},
