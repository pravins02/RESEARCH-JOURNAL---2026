@article{wangHypercoordinateTwodimensionalTransitionmetal2021,
  title = {Hypercoordinate Two-Dimensional Transition-Metal Borides for Spintronics and Catalyst Applications},
  author = {Wang, Shiyao and Khazaei, Mohammad and Wang, Junjie and Hosono, Hideo},
  year = {2021},
