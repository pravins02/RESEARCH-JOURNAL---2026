@misc{kalinOpticalCreationAnnihilation2023,
  title = {Optical Creation and Annihilation of Skyrmion Patches in a Bulk Chiral Magnet},
  author = {Kalin, Jantje and Sievers, Sibylle and Kalin, Daniel and Bauer, Andreas and Abram, Robin and F{\"u}ser, Heiko and Schumacher, Hans Werner and Pfleiderer, Christian and Bieler, Mark},
  year = {2023},
