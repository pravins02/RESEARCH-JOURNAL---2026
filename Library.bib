@article{huangLayerdependentFerromagnetismVan2017,
  title = {Layer-Dependent Ferromagnetism in a van Der {{Waals}} Crystal down to the Monolayer Limit},
  author = {Huang, Bevin and Clark, Genevieve and {Navarro-Moratalla}, Efr{\'e}n and Klein, Dahlia R. and Cheng, Ran and Seyler, Kyle L. and Zhong, Ding and Schmidgall, Emma and McGuire, Michael A. and Cobden, David H. and Yao, Wang and Xiao, Di and {Jarillo-Herrero}, Pablo and Xu, Xiaodong},
  year = {2017},
