@article{mukhopadhyayInvestigationUltrafastDemagnetization2023,
  title = {Investigation of Ultrafast Demagnetization and {{Gilbert}} Damping and Their Correlation in Different Ferromagnetic Thin Films Grown under Identical Conditions},
