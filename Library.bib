@article{chilcoteStoichiometryInducedFerromagnetismAltermagnetic2024,
  title = {Stoichiometry-{{Induced Ferromagnetism}} in {{Altermagnetic Candidate MnTe}}},
  author = {Chilcote, Michael and Mazza, Alessandro R. and Lu, Qiangsheng and Gray, Isaiah and Tian, Qi and Deng, Qinwen and Moseley, Duncan and Chen, An-Hsi and Lapano, Jason and Gardner, Jason S. and Eres, Gyula and Ward, T. Zac and Feng, Erxi and Cao, Huibo and Lauter, Valeria and McGuire, Michael A. and Hermann, Raphael and Parker, David and Han, Myung-Geun and Kayani, Asghar and Rimal, Gaurab and Wu, Liang and Charlton, Timothy R. and Moore, Robert G. and Brahlek, Matthew},
  year = {2024},
  journal = {Advanced Functional Materials},
  volume = {34},
  number = {46},
  pages = {2405829},
  issn = {1616-3028},
  doi = {10.1002/adfm.202405829},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/adfm.202405829},
  urldate = {2024-11-21},
  abstract = {The field of spintronics has seen a surge of interest in altermagnetism due to novel predictions and many possible applications. MnTe is a leading altermagnetic candidate that is of significant interest across spintronics due to its layered antiferromagnetic structure, high Neel temperature (TN {$\approx$} 310 K) and semiconducting properties. The results on molecular beam epitaxy (MBE) grown MnTe/InP(111) films are presented. Here, it is found that the electronic and magnetic properties are driven by the natural stoichiometry of MnTe. Electronic transport and in situ angle-resolved photoemission spectroscopy show the films are natively metallic with the Fermi level in the valence band and the band structure is in good agreement with first-principles calculations for altermagnetic spin-splitting. Neutron diffraction confirms that the film is antiferromagnetic with planar anisotropy and polarized neutron reflectometry indicates weak ferromagnetism, which is linked to a slight Mn-richness that is intrinsic to the MBE-grown samples. When combined with the anomalous Hall effect, this work shows that the electronic response is strongly affected by the ferromagnetic moment. Altogether, this highlights potential mechanisms for controlling altermagnetic ordering for diverse spintronic applications.},
  copyright = {{\copyright} 2024 Wiley-VCH GmbH},
  langid = {english},
  keywords = {altermagnetism,MnTe,molecular beam epitaxy,quantum materials,spintronics},
  file = {C\:\\Users\\pravi\\Zotero\\storage\\SF3PNR64\\Chilcote et al. - 2024 - Stoichiometry-Induced Ferromagnetism in Altermagne.pdf;C\:\\Users\\pravi\\Zotero\\storage\\D2H72VDN\\adfm.html}
}

@article{chouhanEnhancedSpinOrbit2023,
  title = {Enhanced Spin--Orbit Torques in Strained {{NiFe}}/{{Pt}} Bi-Layers on Flexible Substrate},
  author = {Chouhan, Akanksha and Mendonca, Heston A. and Dutta, Sutapa and Shukla, Ambika Shanker and Pandey, Rachit R. and Tulapurkar, Ashwin A.},
  year = {2023},
  month = dec,
  journal = {Journal of Magnetism and Magnetic Materials},
  volume = {587},
  pages = {171337},
  issn = {0304-8853},
  doi = {10.1016/j.jmmm.2023.171337},
  url = {https://www.sciencedirect.com/science/article/pii/S0304885323009873},
  urldate = {2023-11-29},
  abstract = {Magnetization manipulation caused by spin--orbit torque is one of the central themes investigated in spintronics domain. The spin--orbit torque efficiencies can be manoeuvred by application of mechanical strain. In this direction, this study furthers the effort in understanding the evolution of spin--orbit torque efficiencies in mechanically strained ferromagnet (FM)/heavy metal(HM) (Ni81Fe19/Pt) bi-layer films on flexible kapton substrate, by the use of spin torque ferromagnetic resonance (ST-FMR) measurement technique. We report a tensile strain induced enhancement in damping-like and field-like spin--orbit torque efficiencies. The effective damping-like spin torque conductivity increased by 42\% on the application of 0.312\% tensile strain, which is encouraging from the magnetization switching application point of view. In order to investigate the driving factors behind the enhanced damping-like spin torque conductivity, ab-initio calculations were also carried out. Our findings provide insights into the workings of strain in FM/HM bi-layer stack and is a step forward in the implementation of flexible spintronics devices.},
  keywords = {Flexible spintronics,Mechanically strained thin films,Spin Hall conductivity,Spin-orbit torque efficiency,Spin-torque ferromagnetic resonance},
  file = {C\:\\Users\\pravi\\Zotero\\storage\\6HPFB8H2\\Chouhan et al. - 2023 - Enhanced spin–orbit torques in strained NiFePt bi.pdf;C\:\\Users\\pravi\\Zotero\\storage\\ZP83XG3E\\S0304885323009873.html}
}

@article{chowdhuryKagomeMagnetsEmerging2023,
  title = {Kagome {{Magnets}}: {{The Emerging Materials}} for {{Spintronic Memories}}},
  shorttitle = {Kagome {{Magnets}}},
  author = {Chowdhury, Niru and Khan, Kacho Imtiyaz Ali and Bangar, Himanshu and Gupta, Pankhuri and Yadav, Ram Singh and Agarwal, Rekha and Kumar, Akash and Muduli, Pranaba Kishor},
