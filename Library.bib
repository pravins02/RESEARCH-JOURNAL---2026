@article{lepadatuEmergenceTransientDomain2020,
  title = {Emergence of Transient Domain Wall Skyrmions after Ultrafast Demagnetization},
  author = {Lepadatu, Serban},
  year = {2020},
  month = sep,
  journal = {Phys. Rev. B},
  volume = {102},
