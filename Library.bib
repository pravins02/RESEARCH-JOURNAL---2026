  author = {Giustino, Feliciano and Lee, Jin Hong and Trier, Felix and Bibes, Manuel and Winter, Stephen M and Valent{\'i}, Roser and Son, Young-Woo and Taillefer, Louis and Heil, Christoph and Figueroa, Adriana I and Pla{\c c}ais, Bernard and Wu, QuanSheng and Yazyev, Oleg V and Bakkers, Erik P A M and Nyg{\aa}rd, Jesper and {Forn-D{\'i}az}, Pol and De Franceschi, Silvano and McIver, J W and Torres, L E F Foa and Low, Tony and Kumar, Anshuman and Galceran, Regina and Valenzuela, Sergio O and Costache, Marius V and Manchon, Aur{\'e}lien and Kim, Eun-Ah and Schleder, Gabriel R and Fazzio, Adalberto and Roche, Stephan},
  year = {2020},
