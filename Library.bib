@misc{hamameraUltrafastLightinducedMagnetization2023,
  title = {Ultrafast Light-Induced Magnetization in Non-Magnetic Films: From Orbital and Spin {{Hall}} Phenomena to the Inverse {{Faraday}} Effect},
  shorttitle = {Ultrafast Light-Induced Magnetization in Non-Magnetic Films},
  author = {Hamamera, Hanan and Guimar{\~a}es, Filipe Souza Mendes and Dias, Manuel dos Santos and Lounis, Samir},
  year = {2023},
  month = dec,
  number = {arXiv:2312.07888},
  eprint = {2312.07888},
  primaryclass = {cond-mat},
  publisher = {arXiv},
  url = {http://arxiv.org/abs/2312.07888},
  urldate = {2023-12-20},
  abstract = {The field of orbitronics has emerged with great potential to impact information technology by enabling environmentally friendly electronic devices. The main electronic degree of freedom at play is the orbital angular momentum, which can give rise to a myriad of phenomena such as the orbital Hall effect (OHE), torques and orbital magnetoelectric effects. Here, we explore via realistic time-dependent electronic structure simulations the magnetic response of a non-magnetic material, an ultrathin Pt film, to ultrafast laser pulses of different polarizatons and helicities. We demonstrate the generation of significant orbital and spin magnetizations and identify the underlying mechanisms consisting of the interplay of the OHE, inverse Faraday effect and spin-orbit interaction. Our discoveries advocate for the prospect of encoding magnetic information using light in materials that are not inherently magnetic.},
  archiveprefix = {arXiv},
  keywords = {Condensed Matter - Materials Science},
  file = {C\:\\Users\\pravi\\Zotero\\storage\\W5M26QSJ\\Hamamera et al. - 2023 - Ultrafast light-induced magnetization in non-magne.pdf;C\:\\Users\\pravi\\Zotero\\storage\\G49RALWJ\\2312.html}
}

@article{hamaraUltrahighSpinEmission2024,
  title = {Ultra-High Spin Emission from Antiferromagnetic {{FeRh}}},
  author = {Hamara, Dominik and Strungaru, Mara and Massey, Jamie R. and Remy, Quentin and Chen, Xin and Nava Antonio, Guillermo and Alves Santos, Obed and Hehn, Michel and Evans, Richard F. L. and Chantrell, Roy W. and Mangin, St{\'e}phane and Ducati, Caterina and Marrows, Christopher H. and Barker, Joseph and Ciccarelli, Chiara},
  year = {2024},
  month = jun,
  journal = {Nat Commun},
  volume = {15},
  number = {1},
  pages = {4958},
  publisher = {Nature Publishing Group},
  issn = {2041-1723},
  doi = {10.1038/s41467-024-48795-z},
  url = {https://www.nature.com/articles/s41467-024-48795-z},
  urldate = {2025-01-30},
  abstract = {An antiferromagnet emits spin currents when time-reversal symmetry is broken. This is typically achieved by applying an external magnetic field below and above the spin-flop transition or by optical pumping. In this work we apply optical pump-THz emission spectroscopy to study picosecond spin pumping from metallic FeRh as a function of temperature. Intriguingly we find that in the low-temperature antiferromagnetic phase the laser pulse induces a large and coherent spin pumping, while not crossing into the ferromagnetic phase. With temperature and magnetic field dependent measurements combined with atomistic spin dynamics simulations we show that the antiferromagnetic spin-lattice is destabilised by the combined action of optical pumping and picosecond spin-biasing by the conduction electron population, which results in spin accumulation. We propose that the amplitude of the effect is inherent to the nature of FeRh, particularly the Rh atoms and their high spin susceptibility. We believe that the principles shown here could be used to produce more effective spin current emitters. Our results also corroborate the work of others showing that the magnetic phase transition begins on a very fast picosecond timescale, but this timescale is often hidden by measurements which are confounded by the slower domain dynamics.},
  copyright = {2024 The Author(s)},
  langid = {english},
  keywords = {Magnetic properties and materials,Spintronics},
  file = {C:\Users\pravi\Zotero\storage\83LMENX4\Hamara et al. - 2024 - Ultra-high spin emission from antiferromagnetic Fe.pdf}
}

