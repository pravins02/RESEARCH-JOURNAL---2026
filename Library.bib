  keywords = {Condensed Matter - Materials Science,Condensed Matter - Mesoscale and Nanoscale Physics},
  file = {C\:\\Users\\pravi\\Zotero\\storage\\89T7XYQL\\Grubišić-Čabo et al. - 2024 - Roadmap on Quantum Magnetic Materials.pdf;C\:\\Users\\pravi\\Zotero\\storage\\L7T2THX4\\2412.html}
