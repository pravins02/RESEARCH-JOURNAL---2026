@article{slathiaThicknessDependentNanoscale2024,
  title = {Thickness Dependent Nanoscale Magnetism in Two-Dimensional Manganese Telluride ({{MnTe}})},
  author = {Slathia, Surbhi and Tripathi, Manoj and Tromer, Raphael and Gowda, Chinmayee Chowde and Pandey, Prafull and Galvao, Douglas S. and Dalton, Alan and Tiwary, Chandra Sekhar},
  year = {2024},
  month = jun,
  journal = {Materials Today Chemistry},
  volume = {38},
  pages = {102134},
  issn = {2468-5194},
  doi = {10.1016/j.mtchem.2024.102134},
  url = {https://www.sciencedirect.com/science/article/pii/S2468519424002404},
  urldate = {2024-12-04},
  abstract = {Magnetism from two-dimensional (2D) materials has received significant attention and admiration due to their unique electronic and magnetic properties owing to quantum confinement, such as spin-orbit coupling, magnetic anisotropy, and emergent magnetic orders, leading to behaviors and properties not observed in bulk materials. One of the crucial gaps that need to be addressed is deciphering the ordering of magnetic behavior with the thickness of manganese dichalcogenides, manganese telluride (MnTe). The present work explores the pivotal role of thickness in modulating the magnetic properties of 2D MnTe, obtained using liquid-phase exfoliation techniques. Intriguing magnetic and electronic properties have been observed in MnTe thinner than 5~nm. Our experimental findings and density functional theory (DFT) calculations revealed the transition from anti-ferromagnetic characteristics to ferromagnetic behavior for one to two layers and then back to anti-ferromagnetic behavior for thicknesses larger than 5~nm. These results demonstrate the existence of thickness-dependent transitions in magnetic ordering and anisotropy for the 2D materials. The experimental results, in conjunction with theoretical modeling, unravel useful insights into the implications of magnetic 2D MnTe for emerging technologies driven by nanoscale magnetism, such as spintronics and quantum computing. The outcomes from the present work open new possibilities for developing memory devices with enhanced functionality and efficiency.},
  keywords = {2D materials,Density functional theory,Magnetic force microscopy,Magnetism,Manganese telluride},
  file = {C\:\\Users\\pravi\\Zotero\\storage\\E3GXEQAV\\Slathia et al. - 2024 - Thickness dependent nanoscale magnetism in two-dim.pdf;C\:\\Users\\pravi\\Zotero\\storage\\J8IYMNSD\\S2468519424002404.html}
}

