}

@article{khodadadiEnhancedSpinPumping2017,
  title = {Enhanced Spin Pumping near a Magnetic Ordering Transition},
  author = {Khodadadi, Behrouz and Mohammadi, Jamileh Beik and Mewes, Claudia and Mewes, Tim and Manno, M. and Leighton, C. and Miller, Casey W.},
  year = {2017},
