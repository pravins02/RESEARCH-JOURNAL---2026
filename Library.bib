@article{mishinPhaseStabilityFe2005,
  title = {Phase Stability in the {{Fe}}--{{Ni}} System: {{Investigation}} by First-Principles Calculations and Atomistic Simulations},
  shorttitle = {Phase Stability in the {{Fe}}--{{Ni}} System},
  author = {Mishin, Y. and Mehl, M. J. and Papaconstantopoulos, D. A.},
