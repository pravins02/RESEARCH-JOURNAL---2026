  author = {Heinze, Stefan and {von Bergmann}, Kirsten and Menzel, Matthias and Brede, Jens and Kubetzka, Andr{\'e} and Wiesendanger, Roland and Bihlmayer, Gustav and Bl{\"u}gel, Stefan},
  year = {2011},
