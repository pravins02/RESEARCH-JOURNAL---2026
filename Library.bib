  pages = {043105},
  publisher = {American Physical Society},
  doi = {10.1103/PhysRevResearch.4.043105},
  url = {https://link.aps.org/doi/10.1103/PhysRevResearch.4.043105},
  urldate = {2023-09-05},
  abstract = {Skyrmion nucleation induced by spin-transfer torques at an interface of a topological insulator and a ferromagnetic insulator is investigated. Due to strong spin-orbit coupling on a surface of topological insulators, which enhances the effect of spin torques, efficient manipulation of skyrmions is expected, and therefore, topological insulators could provide the ideal platform to achieve high-performance skyrmionic devices. Using micromagnetic simulations and energetics, we evaluate properties of the skyrmion nucleation on a surface of topological insulators, such as nucleation time, critical electric field, and skyrmion numbers. We show that the nucleation time is inversely proportional to the applied electric field. We also identify the Gilbert damping and temperature dependencies of the critical field. Furthermore, we analytically evaluate the effect of the Dzyaloshinskii-Moriya interaction and demonstrate that the temperature dependence can be explained by the reduction of a magnon excitation gap due to the self-energy corrections.},
  file = {C\:\\Users\\pravi\\Zotero\\storage\\E9RDEXUN\\Kurebayashi and Tretiakov - 2022 - Skyrmion nucleation on the surface of a topologica.pdf;C\:\\Users\\pravi\\Zotero\\storage\\WHJESKY4\\PhysRevResearch.4.html}
}

@article{lackThermodynamicPropertiesSwitching2024,
  title = {Thermodynamic Properties and Switching Dynamics of Perpendicular Shape Anisotropy {{MRAM}}},
  author = {Lack, Wayne and Jenkins, Sarah and Meo, Andrea and Chantrell, Roy W and McKenna, Keith M and Evans, Richard F L},
  year = {2024},
  month = apr,
  journal = {J. Phys.: Condens. Matter},
  volume = {36},
  number = {14},
  pages = {145801},
  issn = {0953-8984, 1361-648X},
  doi = {10.1088/1361-648X/ad19a0},
  url = {https://iopscience.iop.org/article/10.1088/1361-648X/ad19a0},
  urldate = {2024-01-22},
  abstract = {The power consumption of modern random access memory (RAM) has been a motivation for the development of low-power non-volatile magnetic RAM (MRAM). Based on a CoFeB/MgO magnetic tunnel junction, MRAM must satisfy high thermal stability and a low writing current while being scaled down to a sub-20 nm size to compete with the densities of current RAM technology. A recent development has been to exploit perpendicular shape anisotropy along the easy axis by creating tower structures, with the free layers' thickness (along the easy axis) being larger than its width. Here we use an atomistic model to explore the temperature dependent properties of thin cylindrical MRAM towers of 5 nm diameter while scaling down the free layer from 48 to 8 nm thick. We find thermal fluctuations are a significant driving force for the switching mechanism at operational temperatures by analysing the switching field distribution from hysteresis data. We find that a reduction of the free layer thickness below 18 nm rapidly loses shape anisotropy, and consequently stability, even at 0 K. Additionally, there is a change in the switching mechanism as the free layer is reduced to 8 nm. Coherent rotation is observed for the 8 nm free layer, while all taller towers demonstrate incoherent rotation via a propagated domain wall.},
  langid = {english},
  file = {C:\Users\pravi\Zotero\storage\LJLL8I7U\pdf.pdf}
}

@article{lambertAllopticalControlFerromagnetic2014,
  title = {All-Optical Control of Ferromagnetic Thin Films and Nanostructures},
  author = {Lambert, C-H. and Mangin, S. and Varaprasad, B. S. D. {\relax Ch}. S. and Takahashi, Y. K. and Hehn, M. and Cinchetti, M. and Malinowski, G. and Hono, K. and Fainman, Y. and Aeschlimann, M. and Fullerton, E. E.},
