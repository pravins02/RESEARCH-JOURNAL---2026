@article{katebEffectAtomicOrdering2019,
  title = {Effect of Atomic Ordering on the Magnetic Anisotropy of Single Crystal {{Ni80Fe20}}},
  author = {Kateb, Movaffaq and Gudmundsson, Jon Tomas and Ingvarsson, Snorri},
  year = {2019},
  month = mar,
  journal = {AIP Advances},
