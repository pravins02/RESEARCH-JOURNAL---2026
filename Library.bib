@article{zhangRoomTemperaturePolar2022,
  title = {A Room Temperature Polar Magnetic Metal},
  author = {Zhang, Hongrui and Shao, Yu-Tsun and Chen, Rui and Chen, Xiang and Susarla, Sandhya and Raftrey, David and Reichanadter, Jonathan T. and Caretta, Lucas and Huang, Xiaoxi and Settineri, Nicholas S. and Chen, Zhen and Zhou, Jingcheng and {Bourret-Courchesne}, Edith and Ercius, Peter and Yao, Jie and Fischer, Peter and Neaton, Jeffrey B. and Muller, David A. and Birgeneau, Robert J. and Ramesh, Ramamoorthy},
