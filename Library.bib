  author = {Wang, Haiyu and Wu, Hao and Zhang, Jie and Liu, Yingjie and Chen, Dongdong and Pandey, Chandan and Yin, Jialiang and Wei, Dahai and Lei, Na and Shi, Shuyuan and Lu, Haichang and Li, Peng and Fert, Albert and Wang, Kang L. and Nie, Tianxiao and Zhao, Weisheng},
