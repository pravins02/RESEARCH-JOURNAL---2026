  shorttitle = {Temperature-Dependent Perpendicular Anisotropy and {{Gilbert}} Damping of \${{L}}\{1\}\_\{0\}{\textbackslash}text\{{\textbackslash}ensuremath\{-\}\}{\textbackslash}mathrm\{\vphantom\}{{FePd}}\vphantom\{\}\$ Films},
