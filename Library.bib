@article{wahabQuantumRescalingDomain2021,
  title = {Quantum {{Rescaling}}, {{Domain Metastability}}, and {{Hybrid Domain-Walls}} in {{2D CrI3 Magnets}}},
  author = {Wahab, Dina Abdul and Augustin, Mathias and Valero, Samuel Manas and Kuang, Wenjun and Jenkins, Sarah and Coronado, Eugenio and Grigorieva, Irina V. and {Vera-Marun}, Ivan J. and {Navarro-Moratalla}, Efr{\'e}n and Evans, Richard F. L. and Novoselov, Kostya S. and Santos, Elton J. G.},
  year = {2021},
  journal = {Advanced Materials},
  volume = {33},
  number = {5},
