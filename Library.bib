@article{casasCoexistenceMeronsSkyrmions,
  title = {Coexistence of {{Merons}} with {{Skyrmions}} in the {{Centrosymmetric Van Der Waals Ferromagnet Fe5}}--{{xGeTe2}}},
  author = {Casas, Brian W. and Li, Yue and Moon, Alex and Xin, Yan and McKeever, Conor and Macy, Juan and {Petford-Long}, Amanda K. and Phatak, Charudatta M. and Santos, Elton J. G. and Choi, Eun Sang and Balicas, Luis},
  journal = {Advanced Materials},
