@article{pattonSymmetryControlUnconventional2023,
  title = {Symmetry {{Control}} of {{Unconventional Spin}}--{{Orbit Torques}} in {{IrO2}}},
  author = {Patton, Michael and Gurung, Gautam and Shao, Ding-Fu and Noh, Gahee and Mittelstaedt, Joseph A. and Mazur, Marcel and Kim, Jong-Woo and Ryan, Philip J. and Tsymbal, Evgeny Y. and Choi, Si-Young and Ralph, Daniel C. and Rzchowski, Mark S. and Nan, Tianxiang and Eom, Chang-Beom},
  year = {2023},
  journal = {Advanced Materials},
