@article{ucarTuningCurieTemperature2013,
  title = {Tuning the {{Curie}} Temperature in {$\gamma$}-{{FeNi}} Nanoparticles for Magnetocaloric Applications by Controlling the Oxidation Kinetics},
  author = {Ucar, Huseyin and Ipus, John J. and Laughlin, D. E. and McHenry, M. E.},
  year = {2013},
  month = mar,
  journal = {Journal of Applied Physics},
  volume = {113},
  number = {17},
  pages = {17A918},
