@article{guanTheoreticalInsightsUltrafast2022,
  title = {Theoretical {{Insights}} into {{Ultrafast Dynamics}} in {{Quantum Materials}}},
  author = {Guan, Mengxue and Chen, Daqiang and Hu, Shiqi and Zhao, Hui and You, Peiwei and Meng, Sheng},
  year = {2022},
  month = feb,
  journal = {Ultrafast Science},
