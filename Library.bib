@article{wangDirectObservationsChiral2019,
  title = {Direct Observations of Chiral Spin Textures in van Der {{Waals}} Magnet {{Fe3GeTe2}} Nanolayers},
  author = {Wang, Hong and Wang, Cuixiang and Zhu, Yan and Li, Zi-An and Zhang, Hongbin and Tian, Huanfang and Shi, Youguo and Yang, Huaixin and Li, Jianqi},
