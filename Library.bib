  author = {Peng, Licong and Yasin, Fehmi S. and Park, Tae-Eon and Kim, Sung Jong and Zhang, Xichao and Nagai, Takuro and Kimoto, Koji and Woo, Seonghoon and Yu, Xiuzhen},
