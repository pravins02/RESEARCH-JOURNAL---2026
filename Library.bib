  urldate = {2023-11-21},
  abstract = {Pure spin-current induced spin--orbit torque in a magnetic layer can externally control its magnetization dynamics including Gilbert damping. Here, we demonstrate control over Gilbert damping ({$\Delta\alpha$}) in Substrate/{$\beta$}-Ta(t)/CoFeB(3~nm)/SiO2(2~nm) heterostructures with widely varying Ta thickness (3~{$\leq~$}t~{$\leq~$}20~nm) having stable {$\beta$}-phase using all-optical time-resolved magneto-optical Kerr effect. The pure spin-current due to the spin Hall effect in {$\beta$}-Ta exerts both damping-like and field-like spin--orbit torque to the CoFeB layer. We estimate the damping-like-torque efficiency over a wide range of t with and without Joule heating. In both cases, we obtained a remarkably high-value of damping-like-torque efficiency ({$\xi$}DL)~{$\sim~$}0.40, suggesting that Joule heating has a negligible effect on the {$\Delta\alpha$}. However, the modulation of precession frequency mainly originates from the Joule heating where contributions from field-like-torque and Oersted field are negligible. The high-value of {$\xi$}DL and its stability over a wide-range of t will be key ingredients for future energy-efficient spintronic and magnonic devices.},
  keywords = {Gilbert damping parameter,Magnetization dynamics,Spin Hall effect,Spin-orbit torque,Thin-film heterostructures,Time-resolved magneto-optical Kerr effect magnetometry},
  file = {C\:\\Users\\pravi\\Zotero\\storage\\ARXRKSWC\\Sahoo et al. - 2023 - All-Optical study of Gilbert damping and spin orbi.pdf;C\:\\Users\\pravi\\Zotero\\storage\\HGQFV4SB\\S0921510722005190.html}
}

