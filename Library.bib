  langid = {english},
  keywords = {Electronic devices,Materials science},
  file = {C:\Users\pravi\Zotero\storage\9Y6KDGZ5\Strungaru et al. - 2022 - Ultrafast laser-driven topological spin textures o.pdf}
}

