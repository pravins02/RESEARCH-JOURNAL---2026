@article{zhangRoomtemperatureSkyrmionLattice2022,
  title = {Room-Temperature Skyrmion Lattice in a Layered Magnet ({{Fe0}}.{{5Co0}}.5){{5GeTe2}}},
  author = {Zhang, Hongrui and Raftrey, David and Chan, Ying-Ting and Shao, Yu-Tsun and Chen, Rui and Chen, Xiang and Huang, Xiaoxi and Reichanadter, Jonathan T. and Dong, Kaichen and Susarla, Sandhya and Caretta, Lucas and Chen, Zhen and Yao, Jie and Fischer, Peter and Neaton, Jeffrey B. and Wu, Weida and Muller, David A. and Birgeneau, Robert J. and Ramesh, Ramamoorthy},
